# ID da planilha do Google Sheets (o trecho da URL entre /d/ e /edit).
# Veja a seção 2 do README para o passo a passo de como criar isso.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Nome da aba NOVA desta coleta (ex.: atacadao-2026-10-01). Troque a cada
# execução: a aba é criada/apagada e reescrita. Nomes das abas originais da
# planilha (Coleta, Insumos, Empresas...) são recusados.
GOOGLE_SHEETS_WORKSHEET_NAME=

# Empresa pesquisada: nome (ou parte) como está na aba "Empresas". Uma por vez.
EMPRESA_COLETA=

# Opcional: pesquisador. Vazio = 1º nome da aba "Pesquisadores".
PESQUISADOR=

# Opcional: IBSessionId enviado à API do Super Adega (header copiado do Network
# do site). Fica só no .env; não é um segredo de conta, mas identifica a sessão.
SUPERADEGA_SESSION_ID=
